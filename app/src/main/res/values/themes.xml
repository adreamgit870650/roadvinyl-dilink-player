<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style name="Theme.MP3Player" parent="BaseTheme.MP3Player" />
    <style name="Theme.MP3Player.Zelda" parent="BaseTheme.MP3Player.Zelda" />
    <style name="Theme.MP3Player.Mario" parent="BaseTheme.MP3Player.Mario" />

    <style name="BaseTheme.MP3Player" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorPrimary">@color/netease_red</item>

        <item name="colorPrimaryVariant">@color/netease_red_dark</item>

        <item name="colorSecondary">@color/netease_red</item>

        <item name="colorOnPrimary">@color/player_button_icon</item>

        <item name="android:windowBackground">@color/background</item>

        <item name="android:textColorPrimary">@color/text_primary</item>

        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialButtonStyle">@style/CarPrimaryButton</item>

    </style>

    <style name="CarPrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>



    <style name="BaseTheme.MP3Player.Zelda" parent="Theme.MaterialComponents.NoActionBar">

        <item name="colorPrimary">@color/zelda_primary</item>

        <item name="colorPrimaryVariant">@color/zelda_primary_dark</item>

        <item name="colorSecondary">@color/zelda_primary</item>

        <item name="colorOnPrimary">@color/zelda_background</item>

        <item name="android:windowBackground">@color/zelda_background</item>

        <item name="android:textColorPrimary">@color/zelda_text_primary</item>

        <item name="android:textColorSecondary">@color/zelda_text_secondary</item>

        <item name="materialButtonStyle">@style/CarPrimaryButton</item>

    </style>



    <style name="BaseTheme.MP3Player.Mario" parent="Theme.MaterialComponents.NoActionBar">

        <item name="colorPrimary">@color/mario_primary</item>

        <item name="colorPrimaryVariant">@color/mario_primary_dark</item>

        <item name="colorSecondary">@color/mario_primary</item>

        <item name="colorOnPrimary">@android:color/white</item>

        <item name="android:windowBackground">@color/mario_background</item>

        <item name="android:textColorPrimary">@color/mario_text_primary</item>

        <item name="android:textColorSecondary">@color/mario_text_secondary</item>

        <item name="materialButtonStyle">@style/CarPrimaryButton</item>

    </style>

</resources>
